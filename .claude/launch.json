{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--cwd",
        "workers/api",
        "--port",
        "8787"
      ],
      "port": 8787
    },
    {
      "name": "app-accounts",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14.2.4",
        "out",
        "-l",
        "3001"
      ],
      "port": 3001
    }
  ]
}